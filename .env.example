PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=jungle_wagering
DB_USER=jungle
DB_PASSWORD=jungle_dev

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://127.0.0.1:4566

SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo

# Start independently, set 1 to activate a worker loop
SQS_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_WORKER_ENABLED=0
OUTBOX_PUBLISHER_ENABLED=0
REFERENCE_WORKER_ENABLED=0

# Protected HTTP endpoints require an external IdP using RS256 JWKS.
# Set to public HTTPS URLs reachable from the API container.
OIDC_ISSUER=
OIDC_AUDIENCE=jungle-financial-api
OIDC_JWKS_URI=

# Internal operational metrics are disabled without a token (12+ chars).
METRICS_TOKEN=

# Never enable outside isolated NODE_ENV=test and a *_test database.
ALLOW_INSECURE_TEST_AUTH=0

# Optional monitoring: metrics protected by METRICS_TOKEN
# Prometheus GET /internal/prometheus accepts Authorization: Bearer token.
HTTP_ACCESS_LOGS=1
OTEL_TRACES_ENABLED=0
OTEL_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_SAMPLE_RATE=0.1
