{
  "name": "jungle-wagering-processor",
  "version": "0.0.1",
  "description": "Transactional wagering processor with Bun, NestJS, PostgreSQL and SQS",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/src/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "bun test --coverage",
    "test:domain": "bun test src/domain",
    "test:debug": "bun test --inspect-brk --no-file-parallelism",
    "test:e2e": "bun test test/app.e2e-spec.ts",
    "dev": "bun --watch src/main.ts",
    "start:bun": "bun dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "mikro-orm migration:up",
    "db:down": "mikro-orm migration:down",
    "sqs:setup": "bun scripts/setup-sqs.ts",
    "test:integration": "RUN_DB_TESTS=1 bun test test/integration"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1164.0",
    "@mikro-orm/core": "^7",
    "@mikro-orm/decorators": "^7",
    "@mikro-orm/migrations": "^7",
    "@mikro-orm/nestjs": "^7",
    "@mikro-orm/postgresql": "^7",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
